n len(self.pairs) # output the number of pairs we have\n    \n    # Read the label/image from the file path\n    def _get_label(self, label_path: Path): \n        content = label_path.read_text().strip()\n        if not content: \n            return 0\n        # We get the class id\n        class_ids = [int(line.split()[0]) for line in content.splitlines()]\n\n        if self.rule == \"first\":\n             return class_ids[0]\n        elif self.rule == \"max\":\n            return max(class_ids)\n        else:\n            raise ValueError(\"rule must be 'first' or 'max'\")\n\n    # ---  Processing stage (load + transform + return) --- \n    def __getitem__(self, idx):\n        # Define what the class will return \n        img_path, label_path = self.pairs[idx]\n\n        # Extract the image + label on the same index\n        image = Image.open(img_path).convert(\"RGB\")\n        y = self._get_label(label_path)\n\n        # Apply transformation from image to tensor \n        if self.transform:\n            image = self.transform(image)\n        return image, y\n\n\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-02-17T21:17:04.407732Z","iopub.execute_input":"2026-02-17T21:17:04.40798Z","iopub.status.idle":"2026-02-17T21:17:04.417554Z","shell.execute_reply.started":"2026-02-17T21:17:04.407949Z","shell.execute_reply":"2026-02-17T21:17:04.417012Z"},"_kg_hide-output":true},"outputs":[],"execution_count":84},{"cell_type":"markdown","source":"**Now we instantiate the dataset **","metadata":{}},{"cell_type":"code","source":"dataset = YoloAsClassification(img_dir = \"/kaggle/input/datasets/marslanarshad/car-accidents-and-deformation-datasetannotated/custom_dataset/images/train\",\n                               label_dir = \"/kaggle/input/datasets/marslanarshad/car-accidents-and-deformation-datasetannotated/custom_dataset/labels/train\",\n                              transform = transforms.Compose([transforms.Resize((224, 224)),transforms.ToTensor()])